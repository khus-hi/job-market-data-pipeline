# Copy this file to .env and fill in your values. .env is gitignored.
# Get keys at https://developer.adzuna.com/ (free tier).
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Optional overrides (defaults shown)
# DATA_DIR=data
# DUCKDB_PATH=data/warehouse.duckdb
# ADZUNA_MAX_PAGES=3            # pages per role query (50 postings per page)
# ADZUNA_MAX_DAYS_OLD=2         # look-back window passed to Adzuna

# Raw landing zone: "local" (data/raw/postings) or "s3" (AWS S3 or MinIO).
# See docs/aws-setup.md. Never commit real keys; .env is gitignored.
STORAGE_BACKEND=local
# S3_BUCKET=your-bucket-name
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=http://localhost:9000   # MinIO only; leave unset for AWS
